# Database - sqlite for dev, postgres for prod
DATABASE_URL=sqlite:///./intent.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/intent

# Groq AI
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Firebase - paste entire service-account JSON as one line, or set path
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Auth bypass for local dev (DO NOT set in production)
AUTH_BYPASS=false

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://

# Server
HOST=0.0.0.0
PORT=8000
